---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Biblioteca">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight">Cassette Library App</h1>
    <p class="mt-2 text-neutral-400">A personal archive for your cassette collection.</p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/cassettes"
        class="inline-flex items-center justify-center rounded bg-amber-500 px-4 py-2 text-sm font-medium text-neutral-950 transition hover:bg-amber-400"
      >
        Browse collection
      </a>
      <a
        href="/admin/new"
        class="inline-flex items-center justify-center rounded border border-neutral-700 px-4 py-2 text-sm font-medium text-neutral-200 transition hover:bg-neutral-800"
      >
        Add cassette
      </a>
    </div>
  </main>
</Layout>
