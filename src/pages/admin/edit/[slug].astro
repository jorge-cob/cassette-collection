---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const cassettes = await getCollection('cassettes');
  return cassettes.map((cassette) => ({
    params: { slug: cassette.id },
    props: { cassette },
  }));
}

const { cassette } = Astro.props;
---

<Layout title={`Edit: ${cassette.data.title}`}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight">Edit: {cassette.data.title}</h1>
    <p class="mt-2 text-neutral-400">Edit form — Soon.</p>
  </main>
</Layout>
